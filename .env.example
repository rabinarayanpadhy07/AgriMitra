# ==============================================================================
# AgriMitra Auth Service - Environment Variables
# Copy this file to .env or set these environment variables in your environment.
# DO NOT commit .env or any file containing real passwords to version control!
# ==============================================================================

# Database Configuration (Aiven MySQL or Local MySQL)
DB_URL=jdbc:mysql://mysql-30774976-agrimitra.h.aivencloud.com:12619/defaultdb?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=your_password_here

# JWT Security Configuration (HMAC-SHA256 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Spring Mail (Gmail SMTP configuration)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# Admin Bootstrap
# On startup, if no ADMIN user exists yet, the registered account with this email
# is automatically promoted to ADMIN. Leave blank to skip auto-bootstrap.
ADMIN_BOOTSTRAP_EMAIL=

# Razorpay Payment Gateway (Test Mode or Live Credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_CURRENCY=INR
